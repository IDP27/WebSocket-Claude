{
  // Terminal → Run Task (ou Cmd+Shift+B para o "make check").
  // Os alvos usam Poetry se estiver instalado; senão, as ferramentas da .venv (Makefile).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make check (Definição de Pronto)",
      "type": "shell",
      "command": "make check",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "make test (cobertura)",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    { "label": "make lint", "type": "shell", "command": "make lint", "problemMatcher": [] },
    { "label": "make format", "type": "shell", "command": "make format", "problemMatcher": [] },
    { "label": "make typecheck (mypy)", "type": "shell", "command": "make typecheck", "problemMatcher": [] },
    { "label": "make imports (camadas)", "type": "shell", "command": "make imports", "problemMatcher": [] },
    {
      "label": "make test-integration (PostgreSQL/RabbitMQ/Redis de teste)",
      "detail": "Precisa de TEST_POSTGRES_DSN/TEST_*_URL e das flags TEST_*_DISPOSABLE=sim (RUNBOOK). Nunca homologação/produção.",
      "type": "shell",
      "command": "make test-integration",
      "problemMatcher": []
    },
    {
      "label": "make test-db (PostgreSQL descartável em contêiner)",
      "detail": "Cria o contêiner, aplica sql/postgres/ e grava .test-db.env (ADR-0021 §9). Remover: make test-db-down.",
      "type": "shell",
      "command": "make test-db",
      "problemMatcher": []
    },
    {
      "label": "make test-postgres (cenários contra o PostgreSQL do test-db)",
      "type": "shell",
      "command": "make test-postgres",
      "problemMatcher": []
    },
    {
      "label": "make test-load (carga do consumer, RNF-13)",
      "detail": "Servidor OHIP simulado + banco simulado; ~2 min. LOAD_* ajustam (tests/load/).",
      "type": "shell",
      "command": "make test-load",
      "problemMatcher": []
    },
    {
      "label": "Specs da Oracle: conferir integridade",
      "type": "shell",
      "command": "make oracle-docs",
      "problemMatcher": []
    },
    {
      "label": "Cobertura em HTML (htmlcov/)",
      "type": "shell",
      "command": "PYTHONPATH=src .venv/bin/pytest -m 'not postgres and not rabbitmq and not redis and not load' --cov --cov-report=html -q && open htmlcov/index.html",
      "problemMatcher": []
    }
  ]
}
