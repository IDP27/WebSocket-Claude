{
  // Depuração. Consumer e publisher leem o .env da raiz (copie do .env.example; fora do git).
  // Use só sandbox OHIP e Oracle/RabbitMQ/Redis de teste. O painel entra na Fase 8.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pytest: arquivo atual",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-q", "-p", "no:cacheprovider"],
      "envFile": "${workspaceFolder}/.vscode/test.env",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "pytest: suíte sem infraestrutura",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "not oracle and not rabbitmq and not redis and not load", "-x", "-q"],
      "envFile": "${workspaceFolder}/.vscode/test.env",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "ohip-consumer (sandbox)",
      "type": "debugpy",
      "request": "launch",
      "module": "ohip_streaming.entrypoints.consumer",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "src" },
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "ohip-api (Oracle/Redis de teste)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["ohip_streaming.entrypoints.api.app:create_app", "--factory", "--port", "8080", "--no-access-log"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "src" },
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "ohip-publisher (RabbitMQ de teste)",
      "type": "debugpy",
      "request": "launch",
      "module": "ohip_streaming.entrypoints.publisher",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "src" },
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
