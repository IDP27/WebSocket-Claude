# =============================================================================
# .env.example — copie para .env (que NÃO é versionado) e preencha.
# Em produção, use EnvironmentFile no systemd ou o cofre de segredos.
# Variáveis de ambiente têm precedência sobre o .env.
# Detalhes de cada campo: src/ohip_streaming/config.py
# =============================================================================

# --- Aplicação
# desenvolvimento | homologacao | producao
APP_ENVIRONMENT=desenvolvimento
# commit do deploy (vai em todo log)
APP_CODE_VERSION=dev

# --- OHIP: gateway e credenciais (Developer Portal → Environments)
OHIP_GATEWAY_URL=https://<gateway-ohip>
OHIP_APP_KEY=
OHIP_CLIENT_ID=
OHIP_CLIENT_SECRET=
# client_credentials (OCIM) | resource_owner (Q-10)
OHIP_AUTH_MODE=client_credentials
# obrigatório em client_credentials
OHIP_ENTERPRISE_ID=
# obrigatório em resource_owner
# OHIP_INTEGRATION_USERNAME=
# OHIP_INTEGRATION_PASSWORD=
# TODO(confirmar-doc) D-2
# OHIP_OAUTH_TOKEN_PATH=/oauth/v1/tokens
# OHIP_OAUTH_SCOPE=urn:opc:hgbu:ws:__myscopes__

# --- OHIP: assinatura
OHIP_CHAIN_CODE=
# vazio = todos os aprovados; ex.: HOTEL1,HOTEL2 (D-9)
OHIP_HOTEL_CODES=
OHIP_DELTA=false
# vazio = todos; ex.: NEW RESERVATION,UPDATE RESERVATION (DV-13)
OHIP_EVENT_ALLOWLIST=
# JSON; ex.: {"reservation": "rsv", "profile": "crm"}
OHIP_MODULE_CODES={}
# fuso do campo "timestamp" do evento (D-3)
OHIP_EVENT_TIMEZONE=UTC

# --- OHIP: protocolo (ADR-0007) — os padrões seguem o guia da Oracle
# OHIP_PING_INTERVAL_S=15
# OHIP_ACK_TIMEOUT_S=10
# OHIP_PONG_TIMEOUT_MIN_S=180
# OHIP_TOKEN_REFRESH_MARGIN_S=300
# mínimo 10 (regra do OHIP)
# OHIP_RECONNECT_MIN_GAP_S=10
# mínimo 120
# OHIP_LOCKOUT_4409_S=120
# OHIP_BACKOFF_4504_S=15
# OHIP_BACKOFF_INITIAL_S=10
# OHIP_BACKOFF_MAX_S=60
# OHIP_DRAIN_TIMEOUT_S=30
# OHIP_WS_MAX_MESSAGE_BYTES=16777216
# OHIP_OVERSIZE_MAX_REPEATS=3
# ligar só após validar o D-4
# OHIP_STATUS_CHECK_ENABLED=false
# OHIP_STATUS_CHECK_MIN_INTERVAL_S=30

# --- Oracle 11g (modo Thick + Instant Client 19)
ORACLE_DSN=<host>:1521/<servico>
ORACLE_USER=ohip_app
ORACLE_PASSWORD=
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient_19_x
# ORACLE_POOL_MIN=1
# ORACLE_POOL_MAX=4
# ORACLE_POOL_WAIT_TIMEOUT_MS=10000
# ORACLE_CALL_TIMEOUT_MS=60000

# --- RabbitMQ
RABBITMQ_URL=amqps://<usuario>:<senha>@<host>/<vhost>
# RABBITMQ_EVENTS_EXCHANGE=ohip.events
# RABBITMQ_UNROUTED_EXCHANGE=ohip.events.unrouted
# RABBITMQ_REPROCESS_EXCHANGE=ohip.reprocess
# RABBITMQ_ENRICHER_QUEUE=ohip.enricher
# RABBITMQ_BROKER_MAX_MESSAGE_BYTES=16777216
# RABBITMQ_PUBLISH_MAX_ATTEMPTS=10
# RABBITMQ_CHANNEL_FAIL_ATTRIBUTION=3
# RABBITMQ_UNROUTED_QUEUE=ohip.unrouted
# RABBITMQ_UNROUTED_MAX_LENGTH=100000
# RABBITMQ_CONNECT_TIMEOUT_S=10
# RABBITMQ_CONFIRM_TIMEOUT_S=30

# --- Publisher (laço da outbox)
# PUBLISHER_POLL_INTERVAL_S=1
# PUBLISHER_BATCH_LIMIT=100
# PUBLISHER_MAX_PARALLEL_CHAINS=8
# PUBLISHER_BROKER_BACKOFF_INITIAL_S=1
# PUBLISHER_BROKER_BACKOFF_MAX_S=60

# --- Redis (token, caches e métricas; sem travas)
REDIS_URL=redis://:<senha>@<host>:6379/0
# REDIS_SEEN_TTL_S=86400
# REDIS_API_STATUS_TTL_S=5
# REDIS_METRICS_TTL_S=60

# --- Consumer
# CONSUMER_INTAKE_QUEUE_MAX=5000
# CONSUMER_INTAKE_QUEUE_MAX_BYTES=67108864
# CONSUMER_INTAKE_STALL_TIMEOUT_S=120
# CONSUMER_BATCH_MAX_EVENTS=200
# CONSUMER_BATCH_MAX_WAIT_MS=200
# CONSUMER_BATCH_MAX_RETRIES=5
# CONSUMER_CONTROL_POLL_INTERVAL_S=5
# Saúde da conexão (última mensagem, ping/pong, RTT) em OHIP_CONSUMER_STATUS
# CONSUMER_STATUS_INTERVAL_S=15

# --- Lease no Oracle (consumer e publisher, ADR-0008)
# LEASE_TTL_S=30
# LEASE_RENEW_INTERVAL_S=10
# LEASE_ACQUIRE_JITTER_S=5

# --- API: SHA-256 (hex) de cada token de serviço → perfil. Nunca o token em claro.
#   gerar hash: printf '%s' "$TOKEN" | sha256sum
API_SERVICE_TOKENS={}
# API_HOST=127.0.0.1
# API_PORT=8080
# API_WORKERS=2
# API_ORACLE_CALL_TIMEOUT_MS=15000
# API_METRICS_CACHE_S=5
# API_READY_CACHE_S=5

# --- Expurgo (ohip-purge, timer diário; ADR-0020 §2). Arquivo de ambiente próprio, com
# ORACLE_USER=ohip_purge (sql/900_grants_example.sql). Padrão: só conta (dry run).
# PURGE_RETENTION_DAYS=90
# PURGE_BATCH_SIZE=5000
# PURGE_PAUSE_MS=200
# PURGE_MAX_RUNTIME_S=3600
# PURGE_CALL_TIMEOUT_MS=300000
PURGE_DRY_RUN=true

# --- Enricher (sem regras até a Q-1; REST desligada até a Q-2, ADR-0019)
# routing keys de ohip.events ligadas à fila ohip.enricher, separadas por vírgula. Vazio: só
# reprocessamentos chegam. Para medir o volume por eventName antes da Q-1: ohip.# (tudo
# termina UNMAPPED). Tirar uma key daqui não desliga a binding no broker (RUNBOOK).
ENRICHER_BINDINGS=
ENRICHER_REST_ENABLED=false
# ENRICHER_PREFETCH=5
# ENRICHER_MAX_ATTEMPTS=3
# ENRICHER_RETRY_DELAY_S=2
# ENRICHER_TRANSIENT_BACKOFF_INITIAL_S=5
# ENRICHER_TRANSIENT_BACKOFF_MAX_S=60
# Mensagens seguidas com a mesma falha que abrem o disjuntor (falha sistêmica, sem DLQ)
# ENRICHER_SYSTEMIC_FAILURE_THRESHOLD=5
# ENRICHER_DEDUP_TTL_S=604800
# ENRICHER_REST_TIMEOUT_S=10
# ENRICHER_REST_RATE_PER_S=5
# ENRICHER_REST_BURST=5
# ENRICHER_REST_CACHE_TTL_S=45
# Recusas seguidas do OAuth até o alerta crítico (credencial ou assinatura)
# ENRICHER_REST_AUTH_REJECTED_ALERT=5
# ENRICHER_RESOURCE_PATHS={"reservation": "/rsv/v1/hotels/{hotelId}/reservations/{primaryKey}", "profile": "/crm/v1/profiles/{primaryKey}"}

# --- Painel ohip-admin (só fala com a API; ADR-0018). Tokens em claro: os mesmos cujo
#   SHA-256 está em API_SERVICE_TOKENS. Usuário e grupos vêm de headers do Nginx (Q-5).
ADMIN_API_BASE_URL=http://127.0.0.1:8080
ADMIN_API_READ_TOKEN=
ADMIN_API_ADMIN_TOKEN=
# chave da sessão (CSRF e mensagens), pelo menos 32 caracteres aleatórios
ADMIN_SECRET_KEY=
# ADMIN_API_TIMEOUT_S=10
# ADMIN_USER_HEADER=X-Forwarded-User
# ADMIN_GROUPS_HEADER=X-Forwarded-Groups
# ADMIN_ADMIN_GROUP=ohip-admin
# ADMIN_READ_GROUP=ohip-read
# ADMIN_REFRESH_S=15
# ADMIN_HOST=127.0.0.1
# fora do endereço local, obrigatório (32+ caracteres; o Nginx manda no header abaixo)
# ADMIN_PROXY_SECRET=
# ADMIN_PROXY_SECRET_HEADER=X-Admin-Proxy-Secret
# ADMIN_PORT=8081
# ADMIN_WORKERS=2

# --- Logs
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=true
