; Contratos de arquitetura (ADR-0005). Rodam com `poetry run lint-imports` e também
; dentro do pytest (tests/architecture/test_import_contracts.py).

[importlinter]
root_package = ohip_streaming
include_external_packages = True

[importlinter:contract:camadas]
name = Camadas: entrypoints > adapters > application > domain
type = layers
layers =
    ohip_streaming.entrypoints
    ohip_streaming.adapters
    ohip_streaming.application
    ohip_streaming.domain

[importlinter:contract:nucleo-sem-infraestrutura]
name = domain e application não importam infraestrutura nem configuração
type = forbidden
source_modules =
    ohip_streaming.domain
    ohip_streaming.application
forbidden_modules =
    oracledb
    websockets
    fastapi
    flask
    aio_pika
    redis
    httpx
    uvicorn
    gunicorn
    starlette
    werkzeug
    jinja2
    aiormq
    pydantic_settings
    ohip_streaming.config

[importlinter:contract:dominio-puro]
name = domain não depende de bibliotecas de log nem de validação
type = forbidden
source_modules =
    ohip_streaming.domain
forbidden_modules =
    structlog
    pydantic
    ohip_streaming.logging

[importlinter:contract:painel-via-api]
name = Painel Flask fala só com a API (ADR-0004)
type = forbidden
source_modules =
    ohip_streaming.entrypoints.admin
forbidden_modules =
    ohip_streaming.adapters.oracle
    ohip_streaming.adapters.redis
    oracledb
    redis
    ; o painel terá configuração própria (URL da API e tokens) e nunca carrega OracleSettings
    ohip_streaming.config

[importlinter:contract:api-e-painel-independentes]
name = API e painel não importam um ao outro
type = independence
modules =
    ohip_streaming.entrypoints.api
    ohip_streaming.entrypoints.admin

[importlinter:contract:ports-por-contexto]
name = Ports por contexto: só common é compartilhado; monitoring lê replay (refatoração 3)
type = layers
layers =
    ohip_streaming.application.ports.monitoring
    ohip_streaming.application.ports.consumer | ohip_streaming.application.ports.auth | ohip_streaming.application.ports.lease | ohip_streaming.application.ports.publisher | ohip_streaming.application.ports.replay | ohip_streaming.application.ports.operations | ohip_streaming.application.ports.enricher | ohip_streaming.application.ports.purge
    ohip_streaming.application.ports.common

[importlinter:contract:monitoring-so-le-replay]
name = Ports: monitoring só lê common e replay (refatoração 3)
type = forbidden
source_modules =
    ohip_streaming.application.ports.monitoring
forbidden_modules =
    ohip_streaming.application.ports.consumer
    ohip_streaming.application.ports.auth
    ohip_streaming.application.ports.lease
    ohip_streaming.application.ports.publisher
    ohip_streaming.application.ports.operations
    ohip_streaming.application.ports.enricher
    ohip_streaming.application.ports.purge
